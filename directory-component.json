{
  "mcpServers": {
    "yaps-memory": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "https://codeload.github.com/richawo/yaps-plugins/tar.gz/189945737dce216c3d8112e86aa4da37786275df",
        "yaps-plugin-memory"
      ],
      "env": {
        "YAPS_PLUGIN_ID": "yaps-memory",
        "YAPS_PLUGIN_VERSION": "0.1.0",
        "YAPS_PLUGIN_HOST": "cursor",
        "YAPS_PLUGIN_TRANSPORT": "mcp",
        "YAPS_MCP_CLIENT_ID": "cursor",
        "YAPS_MCP_AUTO_AUTHORIZE_READ": "0"
      }
    }
  }
}
